# Environment Configuration for ocrPlatform

# Database Configuration
# Local SQLite: sqlite:///./ocrplatform.db
# PostgreSQL: postgresql://postgres:postgres@localhost:5432/ocrplatform
DATABASE_URL=sqlite:///./ocrplatform.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security & JWT
SECRET_KEY=OCR_SUPER_SECRET_KEY_PHASE_2_DEVELOPMENT_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# OCR Pipeline & Ollama Inference Configuration
# Pipeline modes:
#   - hybrid (Default): DocAligner + RapidOCR TextDet + VietOCR + Small Text LLM
#   - hybrid_paddle_vl: DocAligner + RapidOCR TextDet + PaddleOCR-VL-Vi (Ollama GGUF) + Small Text LLM
#   - vlm: DocAligner + Pure Vision-Language Model
OCR_PIPELINE_MODE=hybrid
OLLAMA_BASE_URL=http://localhost:11434
# Text-only LLM presets for Hybrid mode:
#   - qwen2.5:3b (~1.9GB, recommended Vietnamese accuracy on 4GB VRAM)
#   - qwen2.5:1.5b (~0.99GB, fastest lightweight JSON mapper)
#   - qwen3:1.7b (~1.4GB, Qwen3 small text model)
OLLAMA_TEXT_MODEL=qwen2.5:3b
# Vietnamese fine-tuned PaddleOCR-VL GGUF recognizer imported into Ollama
PADDLEOCR_VL_MODEL=paddleocr-vl-vi
PADDLEOCR_VL_STRIP_MIN_ROW_HEIGHT=48
# Pure VLM presets (used when OCR_PIPELINE_MODE=vlm):
#   - qwen2.5vl:3b (~3.2GB, balanced Vietnamese OCR on 4GB VRAM)
#   - qwen3-vl:2b-instruct (~1.9GB, fits completely in 4GB VRAM)
#   - qwen3-vl:4b-instruct (~3.3GB, hybrid 4GB VRAM + system RAM)
#   - qwen2.5vl:7b (~6.0GB, requires >=6GB VRAM or heavy RAM offload)
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1024
OLLAMA_TIMEOUT_SECONDS=240
VLM_MAX_IMAGE_DIMENSION=1280
VLM_CROPPED_MAX_WIDTH=1280
VLM_CROPPED_MAX_HEIGHT=1280

# Seed Accounts
